# Supabase — crée un projet sur https://supabase.com puis colle les clés ici
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...
# Utilisée uniquement côté serveur pour le script de seed (jamais exposée au navigateur)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Nom affiché dans l'app
NEXT_PUBLIC_APP_NAME="Caractère ERP"

# Secret partagé avec caracterestore.com pour authentifier son webhook de
# commandes (voir app/api/webhooks/site-orders/route.ts) — même valeur des
# deux côtés (variable SITE_ORDERS_WEBHOOK_SECRET sur le projet Vercel du site).
SITE_ORDERS_WEBHOOK_SECRET=

# Livraison Yalidine — Espace API du compte marchand (yalidine.app)
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
# Wilaya de départ des expéditions (optionnel, défaut "Alger")
YALIDINE_FROM_WILAYA=Alger
# Protège app/api/cron/sync-yalidine — Vercel Cron envoie automatiquement
# ce secret en "Authorization: Bearer ..." (rien à faire côté Vercel, juste
# définir la même valeur ici)
CRON_SECRET=
