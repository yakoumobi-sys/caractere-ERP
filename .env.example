# --- Base de données (Supabase → Project Settings → Database → Connection string, mode "Session pooler") ---
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Authentification ---
# supabase (production) ou demo (choix du profil, pour montrer l'ERP). Par défaut : supabase si l'URL est définie.
AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : stockage des fichiers clients dans un bucket privé
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=erp-prive
# Obligatoire en mode démo hors développement
SESSION_SECRET=

# --- Yalidine (facultatif : sans clés, tracking et statuts saisis à la main) ---
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
YALIDINE_FROM_WILAYA=Alger
# Secret partagé pour POST /api/webhooks/yalidine (en-tête x-webhook-secret)
YALIDINE_WEBHOOK_SECRET=
# Protège /api/cron/yalidine (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
